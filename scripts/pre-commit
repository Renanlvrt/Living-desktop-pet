#!/usr/bin/env python3
"""
.git/hooks/pre-commit
─────────────────────
Blocks any commit that would expose secrets.

INSTALL (run once from the repo root):
    python scripts/install_hooks.py
  or manually:
    copy scripts\pre-commit .git\hooks\pre-commit

What it checks:
  1. Filename blocklist — rejects files like token.json, credentials.json
  2. Content pattern scan — rejects staged files containing known secret patterns
  3. File-size guard — flags unexpectedly large binary/data files (>500 KB)
"""

import subprocess
import sys
import re
import os

# ── 1. Blocked filenames ──────────────────────────────────────────────────────
BLOCKED_FILENAMES = {
    "credentials.json",
    "token.json",
    ".env",
    "secrets.json",
    "secrets.yaml",
    "secrets.yml",
}

BLOCKED_PATTERNS_FILENAME = [
    re.compile(r"client_secret.*\.json$", re.IGNORECASE),
    re.compile(r".*\.key$", re.IGNORECASE),
    re.compile(r".*\.pem$", re.IGNORECASE),
    re.compile(r".*\.enc$", re.IGNORECASE),
    re.compile(r".*\.p12$", re.IGNORECASE),
    re.compile(r".*\.pfx$", re.IGNORECASE),
    re.compile(r".*token.*\.json$", re.IGNORECASE),
    re.compile(r"config\.secret\.", re.IGNORECASE),
]

# ── 2. Content secret patterns ────────────────────────────────────────────────
SECRET_PATTERNS = [
    # Google OAuth client secrets
    (re.compile(r'"client_secret"\s*:\s*"[^"]+"'), "Google OAuth client_secret"),
    (re.compile(r'"refresh_token"\s*:\s*"[^"]+"'), "OAuth refresh_token"),
    (re.compile(r'"access_token"\s*:\s*"[^"]+"'),  "OAuth access_token"),
    # Generic API keys
    (re.compile(r'(?i)(api[_-]?key|apikey)\s*[=:]\s*["\']?[A-Za-z0-9_\-]{20,}'), "API key"),
    (re.compile(r'(?i)(secret[_-]?key|secretkey)\s*[=:]\s*["\']?[A-Za-z0-9_\-]{20,}'), "Secret key"),
    # AWS
    (re.compile(r'AKIA[0-9A-Z]{16}'), "AWS Access Key ID"),
    (re.compile(r'(?i)aws[_-]?secret[_-]?access[_-]?key\s*[=:]\s*["\']?[A-Za-z0-9/+]{40}'), "AWS Secret"),
    # Generic passwords
    (re.compile(r'(?i)password\s*[=:]\s*["\'][^"\']{6,}["\']'), "Password literal"),
    # Private key blocks
    (re.compile(r'-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----'), "Private key block"),
]

# ── 3. File-size guard ────────────────────────────────────────────────────────
MAX_FILE_SIZE_KB = 500


# ── Helpers ───────────────────────────────────────────────────────────────────

def get_staged_files():
    result = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
        capture_output=True, text=True
    )
    return [f.strip() for f in result.stdout.splitlines() if f.strip()]


def get_staged_content(filepath):
    """Return the staged (index) content of a file as bytes."""
    result = subprocess.run(
        ["git", "show", f":{filepath}"],
        capture_output=True
    )
    return result.stdout


def check_filename(filepath):
    basename = os.path.basename(filepath).lower()
    if basename in {f.lower() for f in BLOCKED_FILENAMES}:
        return f"Blocked filename: {filepath}"
    for pat in BLOCKED_PATTERNS_FILENAME:
        if pat.search(basename):
            return f"Blocked filename pattern matched: {filepath}"
    return None


def check_content(filepath, content_bytes):
    try:
        text = content_bytes.decode("utf-8", errors="replace")
    except Exception:
        return None   # binary file — skip content scan

    for pattern, label in SECRET_PATTERNS:
        if pattern.search(text):
            return f"Secret pattern [{label}] in: {filepath}"
    return None


def check_size(filepath, content_bytes):
    size_kb = len(content_bytes) / 1024
    if size_kb > MAX_FILE_SIZE_KB:
        return f"Large file ({size_kb:.0f} KB > {MAX_FILE_SIZE_KB} KB): {filepath}"
    return None


# ── Main ──────────────────────────────────────────────────────────────────────

def main():
    errors = []
    staged = get_staged_files()

    for filepath in staged:
        # Filename check
        err = check_filename(filepath)
        if err:
            errors.append(err)
            continue   # no need to check content if filename is already blocked

        content = get_staged_content(filepath)

        # Content check
        err = check_content(filepath, content)
        if err:
            errors.append(err)

        # Size check (warning, not hard block)
        warn = check_size(filepath, content)
        if warn:
            print(f"\033[33m[WARNING] {warn}\033[0m")

    if errors:
        print("\n\033[31m+------------------------------------------------------+")
        print("|   [!] COMMIT BLOCKED -- SECRET DETECTED              |")
        print("+------------------------------------------------------+\033[0m\n")
        for e in errors:
            print(f"\033[31m  [X]  {e}\033[0m")
        print("\n\033[33mFix: remove the sensitive file/content, then try again.\033[0m")
        print("If this is a false positive, use:  git commit --no-verify\n")
        sys.exit(1)

    print("\033[32m[OK]  Pre-commit security check passed.\033[0m")
    sys.exit(0)


if __name__ == "__main__":
    main()
